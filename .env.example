# URL de l'application OptiSpace (boutons « Essai gratuit » / « Se connecter »)
NEXT_PUBLIC_APP_URL=https://www.optiwifi.site
# URL publique du site vitrine (images de partage Open Graph)
NEXT_PUBLIC_SITE_URL=https://space.optiwifi.site
# API du contenu géré dans le back-office (défaut : <NEXT_PUBLIC_APP_URL>/api/public/site-content)
SITE_CONTENT_API_URL=https://www.optiwifi.site/api/public/site-content
