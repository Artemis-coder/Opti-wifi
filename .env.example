# ==============================================================================
# OPTIWIFI - Configuration des Variables d'Environnement
# ==============================================================================
# Ce fichier sert de modèle pour configurer vos environnements :
# - Local Development (.env.local)
# - Vercel Preview (Variables configurées dans le dashboard Vercel pour l'env "Preview")
# - Vercel Production (Variables configurées dans le dashboard Vercel pour l'env "Production")
#
# IMPORTANT :
# 1. Ne JAMAIS commiter de vrais secrets ou de clés réelles dans Git.
# 2. Pour le développement local et Vercel Preview, utilisez TOUJOURS la base Neon DEV.
# 3. La base Neon de PRODUCTION est réservée strictement à Vercel Production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES NEON (PostgreSQL)
# ------------------------------------------------------------------------------
# En Local et Vercel Preview : pointez vers la branche Neon de développement (ex: develop)
# En Production : pointez vers la branche Neon de production (ex: production / ep-flat-term-***)
DATABASE_URL=postgresql://neondb_owner:VOTRE_MOT_DE_PASSE_DEV@ep-misty-night-ayhq9iik-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:VOTRE_MOT_DE_PASSE_DEV@ep-misty-night-ayhq9iik.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optionnel : Si vous devez explicitement autoriser la connexion en mode dev
# ALLOW_PROD_DB_IN_DEV=false

# ------------------------------------------------------------------------------
# 2. AUTHENTIFICATION & SÉCURITÉ (JWT)
# ------------------------------------------------------------------------------
# Clé secrète pour signer les JWT de session (min 32 caractères aléatoires)
# Commande pour générer : openssl rand -base64 48
JWT_SECRET=votre_cle_jwt_secrete_aleatoire_pour_le_dev_32chars_min

# ------------------------------------------------------------------------------
# 3. URL DE L'APPLICATION
# ------------------------------------------------------------------------------
# Local : http://localhost:3000
# Preview : Laisser vide (Next.js/Vercel utilise VERCEL_URL dynamiquement) ou URL de preview
# Production : https://www.optiwifi.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. CONFIGURATION EMAIL (SMTP - ex: Gmail App Password ou Brevo / Resend)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact-dev@optiwifi.site
SMTP_PASS=votre_mot_de_passe_application_smtp
SMTP_SECURE=false
SMTP_FROM=contact-dev@optiwifi.site
SMTP_FROM_NAME="OptiSpace Dev"

# ------------------------------------------------------------------------------
# 5. NOTIFICATIONS TELEGRAM (Optionnel / Sandbox en dev)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=votre_token_bot_telegram_dev_ou_sandbox
TELEGRAM_CHAT_ID=votre_chat_id_telegram_de_test

# ------------------------------------------------------------------------------
# 6. TÂCHES PLANIFIÉES / CRON SECRET
# ------------------------------------------------------------------------------
# Jeton secret pour sécuriser l'appel à /api/cron/health-check
CRON_SECRET=votre_secret_aleatoire_pour_les_crons

# ------------------------------------------------------------------------------
# 7. FOURNISSEURS IA (Optionnels / Clés de test)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-cle-de-test-openrouter
GROQ_API_KEY=gsk_cle-de-test-groq
TOGETHER_API_KEY=cle-de-test-together

# ------------------------------------------------------------------------------
# 8. LEGACY SUPABASE (Conservé pour rétro-compatibilité temporaire)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet-dev.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_de_test
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_de_test